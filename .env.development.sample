# ==============================================================================
# .env.development — Variables para desarrollo local
# Sobreescribe las variables del .env principal.
#
# dotenv:     NO sobreescribe env vars que ya existen, el .env principal se
#             carga primero. Para dev local, dotenv carga este archivo después.
# Vite:       Carga .env.development con mayor prioridad que .env
# ==============================================================================

# ==============================================================================
# Base de datos de pre-producción (local)
# ==============================================================================
PREPROD_DBSERVER=your-local-server
PREPROD_DBNAME=your-preprod-dbname
PREPROD_DBUSERNAME=your-preprod-dbuser
PREPROD_DBPASSWORD=your-preprod-dbpassword

# ==============================================================================
# Base de datos de la aplicación (local)
# ==============================================================================
DBSERVER=your-local-server
DBNAME=your-dbname
DBUSERNAME=your-dbuser
DBPASSWORD=your-dbpassword

# ==============================================================================
# Backend (overrides)
# ==============================================================================
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173
JWT_SECRET=your-jwt-secret-key
PASS_PHRASE=your-pass-phrase-key
TIMEZONE_DATABASE=America/Lima

# JWT Token TTL (en segundos)
# JWT_ACCESS_TOKEN_TTL: default 900 (15 min)
# JWT_REFRESH_TOKEN_TTL: default 2592000 (30 días)
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=2592000

# ==============================================================================
# Sentry (deshabilitado en dev)
# ==============================================================================
SENTRY_REPORTING_ENABLED=false
SENTRY_DNS=https://your-sentry-dsn

# ==============================================================================
# Loki (logging centralizado)
# ==============================================================================
LOKI_REPORTING_ENABLED=false
LOKI_HOST=http://localhost:3100
LOKI_USERNAME=
LOKI_PASSWORD=
LOKI_LOG_LEVEL=info

# ==============================================================================
# Cache (Valkey/Redis)
# ==============================================================================
CACHE_HOST=localhost
CACHE_PORT=6379
CACHE_PASSWORD=your-cache-password
BUSQUEDA_RECIENTE_CACHE_TTL=86400

# ==============================================================================
# Frontend (dev local)
# ==============================================================================
VITE_API_URL=http://localhost:3000

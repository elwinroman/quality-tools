# ==============================================================================
# .env.local - Variables para desarrollo local
#
# Este archivo es la unica fuente local que carga el backend.
# No hay fallback silencioso a .env.backend ni .env.
# ==============================================================================

# ==============================================================================
# Base de datos de pre-produccion (local)
# ==============================================================================
PREPROD_DBSERVER=your-local-server
PREPROD_DBNAME=your-preprod-dbname
PREPROD_DBUSERNAME=your-preprod-dbuser
PREPROD_DBPASSWORD=your-preprod-dbpassword

# ==============================================================================
# Base de datos de la aplicacion (local)
# ==============================================================================
DBSERVER=your-local-server
DBNAME=your-dbname
DBUSERNAME=your-dbuser
DBPASSWORD=your-dbpassword

# ==============================================================================
# Backend local
# ==============================================================================
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173
JWT_SECRET=your-jwt-secret-key
PASS_PHRASE=your-pass-phrase-key
TIMEZONE_DATABASE=America/Lima

# JWT Token TTL (en segundos)
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=2592000

# ==============================================================================
# Sentry (deshabilitado en dev)
# ==============================================================================
SENTRY_REPORTING_ENABLED=false
SENTRY_DNS=https://your-sentry-dsn

# ==============================================================================
# Observabilidad
# ==============================================================================
LOG_LEVEL=debug
OTEL_DEPLOYMENT_ENV=development
OTEL_LOGS_ENABLED=false
OTEL_SERVICE_NAME=quality-tools-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_RESOURCE_ATTRIBUTES=project=quality-tools
OTEL_LOG_EXPORT_INTERVAL=5000
OTEL_LOG_EXPORT_TIMEOUT=5000

# ==============================================================================
# Cache (Valkey/Redis local)
# ==============================================================================
CACHE_HOST=localhost
CACHE_PORT=6379
CACHE_PASSWORD=your-cache-password
BUSQUEDA_RECIENTE_CACHE_TTL=86400

# ==============================================================================
# Frontend local
# ==============================================================================
VITE_API_URL=http://localhost:3000

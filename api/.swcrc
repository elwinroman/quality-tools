{
  "$schema": "https://json.schemastore.org/swcrc",
  "sourceMaps": true,
  "minify": false,
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "decorators": true,
      "dynamicImport": true
    },
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"],
      "@core/*": ["src/core/*"],
      "@shared/*": ["src/modules/shared/*"],
      "@observability/*": ["src/modules/observability/*"],
      "@auth/*": ["src/modules/auth/*"],
      "@finlog/*": ["src/modules/fin-log/*"],
      "@sysobject/*": ["src/modules/sysobject/*"],
      "@busqueda-reciente/*": ["src/modules/busqueda-reciente/*"],
      "@favorito/*": ["src/modules/favorito/*"]
    },
    "target": "esnext",
    "minify": {
      "compress": false,
      "mangle": false
    }
  },
  "module": {
    "type": "es6",
    "resolveFully": true
  }
}

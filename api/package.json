{
  "name": "api",
  "version": "2.0.0",
  "description": "Api rest interna",
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "build": "npm run validate-typescript && npm run build:clean && npm run generate-dist",
    "build:prod": "cross-env NODE_ENV=production npm run build",
    "start": "node ./dist/index.js",
    "dev": "nodemon",
    "build:clean": "rimraf dist; exit 0",
    "validate-typescript": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "generate-dist": "swc ./src -d dist --strip-leading-paths",
    "cli:crypto": "tsx cli-crypto.ts"
  },
  "author": "Elwin Roman",
  "license": "ISC",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@formkit/tempo": "0.1.2",
    "@opentelemetry/api-logs": "^0.219.0",
    "@opentelemetry/auto-instrumentations-node": "^0.77.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.219.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-logs": "^0.219.0",
    "@opentelemetry/sdk-metrics": "^2.8.0",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@sentry/node": "^9.19.0",
    "cookie-parser": "1.4.6",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "inquirer": "^12.11.1",
    "iovalkey": "^0.3.1",
    "jsonwebtoken": "9.0.2",
    "mssql": "11.0.1",
    "picocolors": "1.0.1",
    "pino": "^9.6.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "9.9.1",
    "@swc/cli": "0.4.0",
    "@swc/core": "1.7.22",
    "@types/cookie-parser": "1.4.7",
    "@types/cors": "2.8.17",
    "@types/eslint__js": "8.42.3",
    "@types/express": "4.17.21",
    "@types/express-session": "1.18.0",
    "@types/inquirer": "^9.0.9",
    "@types/jsonwebtoken": "9.0.6",
    "@types/mssql": "9.1.5",
    "@types/node": "22.10.10",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "2.0.3",
    "cross-env": "^7.0.3",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.2.1",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "15.9.0",
    "nodemon": "3.1.4",
    "pino-pretty": "^13.0.0",
    "prettier": "3.3.3",
    "rimraf": "6.0.1",
    "standard": "17.1.0",
    "tsx": "4.19.0",
    "typescript": "5.5.4",
    "typescript-eslint": "8.3.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "2.0.3"
  }
}

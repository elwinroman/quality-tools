# ==============================================================================
# .env.backend - Variables del backend en Docker/produccion
#
# Las credenciales de base de datos deben estar encriptadas con PASS_PHRASE.
# Usar: bash setup/01_encrypt_credentials.sh
# ==============================================================================

# ==============================================================================
# Base de datos de pre-produccion
# ==============================================================================
PREPROD_DBSERVER=host
PREPROD_DBNAME=your-preprod-dbname
PREPROD_DBUSERNAME=your-encrypted-preprod-dbuser
PREPROD_DBPASSWORD=your-encrypted-preprod-dbpassword

# ==============================================================================
# Base de datos de la aplicacion
# ==============================================================================
DBSERVER=host
DBNAME=your-dbname
DBUSERNAME=your-encrypted-dbuser
DBPASSWORD=your-encrypted-dbpassword

# ==============================================================================
# Backend
# ==============================================================================
NODE_ENV=production
JWT_SECRET=your-jwt-secret-key
PASS_PHRASE=your-pass-phrase-key

# ==============================================================================
# Sentry (error tracking)
# ==============================================================================
SENTRY_REPORTING_ENABLED=true
SENTRY_DNS=https://your-sentry-dsn

# ==============================================================================
# Observabilidad
# ==============================================================================
LOG_LEVEL=info
OTEL_DEPLOYMENT_ENV=production
OTEL_LOGS_ENABLED=true
OTEL_METRICS_ENABLED=false
OTEL_SERVICE_NAME=quality-tools-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_RESOURCE_ATTRIBUTES=project=quality-tools
OTEL_METRIC_EXPORT_INTERVAL=15000
OTEL_METRIC_EXPORT_TIMEOUT=5000
OTEL_LOG_EXPORT_INTERVAL=5000
OTEL_LOG_EXPORT_TIMEOUT=5000

# ==============================================================================
# Cache (Valkey/Redis)
# ==============================================================================
CACHE_HOST=valkey
CACHE_PORT=6379
CACHE_PASSWORD=your-cache-password
